<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HBBackoffice" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Hintergrundfarbe des Splash Screens (z.B. ein dunkles Blau/Grau) -->
        <item name="windowSplashScreenBackground">#121212</item>
        <!-- Icon in der Mitte -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <!-- Das eigentliche Theme nach dem Splash Screen -->
        <item name="postSplashScreenTheme">@style/Theme.HBBackoffice</item>
    </style>
</resources>